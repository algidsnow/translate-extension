{
  "manifest_version": 3,
  "name": "Vocab Helper (Ollama)",
  "version": "4.0",
  "description": "Bôi đen từ để dịch bằng Ollama AI, lưu lên Supabase cloud.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}